# 히어로 검색창(/api/ask)이 쓰는 키. 이 파일을 .env.local로 복사해 값을 채운다.
# Vercel에는 Project Settings → Environment Variables에 같은 이름으로 넣는다.
# 전부 비어 있어도 사이트는 동작한다 — 키워드 규칙과 직접 쓴 답변만으로 답한다.

# Claude: 직접 쓴 답변이 없는 질문에 사이트 내용을 근거로 답한다.
ANTHROPIC_API_KEY=

# Jev: 질문을 분류한다. 아래 둘 중 하나만 있으면 된다.
# 1) TypeSafe 키가 있으면 TypeSafe에 바로 보낸다. 이쪽이 먼저다.
TYPESAFE_API_KEY=
# 2) 없으면 Vercel AI Gateway를 거친다. Vercel 배포 환경에서는 비워 둬도 된다 —
#    자동으로 들어오는 VERCEL_OIDC_TOKEN을 쓴다.
AI_GATEWAY_API_KEY=

# 1이면 Jev와 Claude를 부르지 않는다. 키워드 규칙과 가짜 Claude 답변으로 화면만 확인할 때 쓴다 (비용 0).
ASK_DRY_RUN=

# 질문 기록(ask_log)을 쓰는 Neon Postgres 접속 주소. Vercel에서 Neon을 연결하면 자동으로 들어온다.
# 비어 있으면 기록하지 않는다. 표는 `node --env-file=.env.local db/init.mjs`로 처음 한 번 만든다.
DATABASE_URL=
